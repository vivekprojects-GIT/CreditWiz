# Local MVP: no external model calls by default.
CREDITWIZ_ENV=development
CREDITWIZ_DISABLE_LLM=1
ANTHROPIC_API_KEY=
# To enable Claude search: set your key, disable flag to 0, and an available model.
CREDITWIZ_SEARCH_MODEL=claude-sonnet-5
CREDITWIZ_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional absolute paths; defaults are backend/data and backend/var.
# CREDITWIZ_DATA_DIR=
# CREDITWIZ_VAR_DIR=
# Production requires HTTPS and provisioned password accounts; demo sign-in is disabled.
# CREDITWIZ_ENV=production
# Optional first administrator bootstrap instead of app.manage user:
# CREDITWIZ_BOOTSTRAP_EMAIL=
# CREDITWIZ_BOOTSTRAP_PASSWORD=
